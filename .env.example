# Copiez en .env sur le serveur (jamais dans git), puis : chmod 600 .env
# Base SQLite (chemin absolu conseillé en production)
DATABASE_URL=file:/opt/etiquettes/db/custom.db
# Dossier des fichiers d'exploitation (cloud.config.json, ofs-sites.json, mail…)
APP_DIR=/opt/etiquettes
# Priment sur cloud.config.json :
SUPABASE_URL=https://VOTRE-PROJET.supabase.co
SUPABASE_SECRET_KEY=sb_secret_A_REMPLIR
# Générer avec : openssl rand -base64 48
SESSION_SECRET=A_REMPLIR
